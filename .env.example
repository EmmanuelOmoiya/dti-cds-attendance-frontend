# Copy to .env.local and adjust.

# ── Server-only (never exposed to the browser) ──
# Base URL of the NestJS API, including the version prefix. The browser never calls this directly:
# every request goes through the dashboard's own server-side proxy (/api/backend/*), which keeps
# the user's tokens in HttpOnly cookies.
API_BASE_URL=http://localhost:5000/api/v1

# Set to "true" only when the dashboard is served over HTTPS (production). Adds the Secure flag
# to auth cookies. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# ── Public (safe to expose) ──
# Timezone used to display instants that are not tied to a session (audit logs, sync times...).
# Session times are always shown in the session's own timezone returned by the API.
NEXT_PUBLIC_DISPLAY_TIMEZONE=Africa/Lagos
